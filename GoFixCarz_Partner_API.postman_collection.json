{
  "info": {
    "name": "GoFixCarz Partner API",
    "_postman_id": "gofixcarz-partner-api-v1",
    "description": "Complete API collection for the GoFixCarz Partner app.\n\n**Setup:**\n1. Import this collection AND the `GoFixCarz_Partner.postman_environment.json` file.\n2. Select the **GoFixCarz Partner** environment from the top-right dropdown.\n3. Run **Auth → Send OTP**, then **Auth → Verify OTP** — the access token is saved automatically.\n4. All authenticated requests will use `{{access_token}}` from the environment.\n\n**Base URLs:**\n- Backend API: `https://api.gofixcarz.com/api/v1`\n- Local API Server: `{{local_api_url}}` (set to your Replit dev domain, e.g. `https://<slug>.replit.dev/api-server/api`)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.gofixcarz.com/api/v1",
      "type": "string"
    },
    {
      "key": "local_api_url",
      "value": "http://localhost:3001/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "description": "Authentication endpoints. Run Send OTP → Verify OTP to get a token. The Verify OTP request auto-saves access_token and refresh_token to the active environment.",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/send-otp", "host": ["{{base_url}}"], "path": ["auth", "send-otp"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{mobile}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Send an OTP to the garage owner's mobile number. The OTP will arrive via SMS."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"OTP sent successfully\"\n}"
            }
          ]
        },
        {
          "name": "Verify OTP  ← auto-saves token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data) {",
                  "  const d = res.data;",
                  "  if (d.access_token)  pm.environment.set('access_token',  d.access_token);",
                  "  if (d.refresh_token) pm.environment.set('refresh_token', d.refresh_token);",
                  "  if (d.user && d.user.id) pm.environment.set('partner_id', d.user.id);",
                  "  console.log('✅ Tokens saved to environment');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/verify-otp", "host": ["{{base_url}}"], "path": ["auth", "verify-otp"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{mobile}}\",\n  \"otp\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Verify the OTP. On success the test script automatically saves `access_token`, `refresh_token`, and `partner_id` to the active environment."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"access_token\": \"eyJ...\",\n    \"refresh_token\": \"eyJ...\",\n    \"user\": {\n      \"id\": \"uuid\",\n      \"name\": \"Ramesh Patel\",\n      \"mobile\": \"9876543210\",\n      \"email\": \"ramesh@autocare.com\",\n      \"is_active\": true\n    }\n  }\n}"
            }
          ]
        },
        {
          "name": "Sign In (mobile + password)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/sign-in", "host": ["{{base_url}}"], "path": ["auth", "sign-in"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{mobile}}\",\n  \"password\": \"your_password\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Sign Up (new garage)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/sign-up", "host": ["{{base_url}}"], "path": ["auth", "sign-up"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Ramesh\",\n  \"last_name\": \"Patel\",\n  \"workshop_name\": \"AutoCare Garage\",\n  \"email\": \"ramesh@autocare.com\",\n  \"mobile\": \"9876543210\",\n  \"address\": \"12, MG Road\",\n  \"city\": \"Bangalore\",\n  \"state\": \"Karnataka\",\n  \"zipcode\": \"560001\",\n  \"country\": \"India\",\n  \"country_code\": \"+91\",\n  \"wheelers\": [\"2-wheeler\", \"4-wheeler\"],\n  \"terms_accepted\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Register a new garage/partner account.\n\n**Required:** first_name, workshop_name, mobile, terms_accepted\n**Optional:** last_name, email, address, city, state, zipcode, country, country_code, wheelers"
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data) {",
                  "  if (res.data.access_token)  pm.environment.set('access_token',  res.data.access_token);",
                  "  if (res.data.refresh_token) pm.environment.set('refresh_token', res.data.refresh_token);",
                  "  console.log('✅ Tokens refreshed');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/refresh", "host": ["{{base_url}}"], "path": ["auth", "refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Get a new access token using the refresh token. Auto-saves updated tokens."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth", "logout"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Invalidate the session. Pass the refresh token to fully revoke it server-side."
          }
        }
      ]
    },
