        {
          "name": "Accept Booking",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{base_url}}/bookings/{{booking_id}}/accept",
              "host": ["{{base_url}}"],
              "path": ["bookings", "{{booking_id}}", "accept"]
            },
            "description": "Accept a PENDING booking. Status changes to ACCEPTED. No request body required."
          }
        },
        {
          "name": "Reject Booking",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{base_url}}/bookings/{{booking_id}}/reject",
              "host": ["{{base_url}}"],
              "path": ["bookings", "{{booking_id}}", "reject"]
            },
            "description": "Reject a PENDING booking. Status changes to REJECTED. No request body required."
          }
        },
        {
          "name": "Convert Booking → Create Job",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/bookings/{{booking_id}}/create-job",
              "host": ["{{base_url}}"],
              "path": ["bookings", "{{booking_id}}", "create-job"]
            },
            "description": "Convert an ACCEPTED booking into a Job card. Booking status changes to CONVERTED. Returns the new JobResponse.\n\nNo request body required — job details are pre-filled from the booking."
          }
        }
      ]
    },
