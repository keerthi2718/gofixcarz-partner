    {
      "name": "📅 Bookings",
      "item": [
        {
          "name": "List Bookings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/bookings?page=1&page_size=10",
              "host": ["{{base_url}}"],
              "path": ["bookings"],
              "query": [
                { "key": "status",    "value": "",   "description": "PENDING | ACCEPTED | REJECTED | CONVERTED", "disabled": true },
                { "key": "page",      "value": "1" },
                { "key": "page_size", "value": "10" }
              ]
            },
            "description": "Returns a paginated list of bookings for this garage.\n\n**Status values:** PENDING, ACCEPTED, REJECTED, CONVERTED"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"items\": [\n      {\n        \"id\": \"uuid\",\n        \"garage_id\": \"uuid\",\n        \"customer_id\": \"uuid\",\n        \"vehicle_id\": null,\n        \"status\": \"PENDING\",\n        \"booking_date\": \"2026-07-30T10:00:00Z\",\n        \"notes\": \"Car makes noise when braking\",\n        \"customer_name\": \"Arjun Singh\",\n        \"customer_mobile\": \"9123456789\",\n        \"service_requested\": \"Brake inspection\",\n        \"created_at\": \"2026-07-28T09:00:00Z\",\n        \"updated_at\": \"2026-07-28T09:00:00Z\"\n      }\n    ],\n    \"total\": 23,\n    \"page\": 1,\n    \"page_size\": 10\n  }\n}"
            }
          ]
        },
        {
          "name": "List Bookings — PENDING only",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/bookings?status=PENDING&page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["bookings"],
              "query": [
                { "key": "status",    "value": "PENDING" },
                { "key": "page",      "value": "1" },
                { "key": "page_size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Booking Detail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/bookings/{{booking_id}}",
              "host": ["{{base_url}}"],
              "path": ["bookings", "{{booking_id}}"]
            },
            "description": "Get full detail of a single booking including customer and vehicle info."
          }
