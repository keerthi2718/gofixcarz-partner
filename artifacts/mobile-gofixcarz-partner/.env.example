# GoFixCarz Partner — Environment Variable Template
# Copy this file to .env and fill in your values.
# EXPO_PUBLIC_ prefix is required for variables accessible in the Expo client bundle.

# API
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api
EXPO_PUBLIC_APP_ENV=development

# App
EXPO_PUBLIC_APP_NAME=GoFixCarz Partner

# Google Places API — enables address autocomplete on the registration screen.
# Get a key at https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Places API (New) or Places API (Legacy)
# Restrict the key to "Android apps" and your package name for production.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
