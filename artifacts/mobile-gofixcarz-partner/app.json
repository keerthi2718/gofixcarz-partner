{
  "expo": {
    "name": "GoFixCarz Partner",
    "slug": "mobile-gofixcarz-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile-gofixcarz-partner",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo_clean.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gofixcarz.partner",
      "config": {
        "googleMapsApiKey": "AIzaSyBUCnvnJyRUoph57Ft2X3Qhkkbfz8Ldkls"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gofixcarz.partner",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBUCnvnJyRUoph57Ft2X3Qhkkbfz8Ldkls"
        }
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Feather.ttf"
          ]
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2563EB",
          "defaultChannel": "default",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "EXPO_PUBLIC_GOOGLE_PLACES_API_KEY": "AIzaSyBUCnvnJyRUoph57Ft2X3Qhkkbfz8Ldkls",
      "eas": {
        "projectId": "33af7382-e378-4e0b-ae76-44c030a71588"
      }
    },
    "owner": "keerthi27"
  }
}
